# A symbolic operator that opens a line continues the expression above it, since a newline inside
# one expression is insignificant (`spec/grammar.md:34`, issue #933). Only a *symbolic* operator
# does: a word operator is also a statement head, so continuing on one could swallow a statement.
print 1
  + 2
print 10
  - 4
print 3
  * 4
print 1
  < 2
