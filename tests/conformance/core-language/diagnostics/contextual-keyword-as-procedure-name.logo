# The contextual keywords `empty`, `member`, `of`, and `a` are NOT built-in names
# (spec/grammar.md:382): they are structural by POSITION only -- in the `is` predicate forms, and
# additionally in the Heritage `value of ... for key` reader for `of` -- and stay ordinary names
# everywhere else. A declaration slot is one of those "everywhere else" positions, so each is a
# legal procedure name in the callable namespace and calling it resolves cleanly. This is the
# mirror of the built-in-name fixtures: where `define repeat ... end` raises `ol-reserved-word`,
# `define empty ... end` produces no diagnostic.
define empty :x
  print :x
end
define member :x
  print :x
end
define of :x
  print :x
end
define a :x
  print :x
end
empty 1
member 2
of 3
a 4
