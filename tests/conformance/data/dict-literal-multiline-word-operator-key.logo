# `and`, `or`, `mod` and `is` are legal dictionary keys, so a worded operator that opens a line
# inside a dict literal opens the NEXT ENTRY rather than continuing the previous entry's value
# (issue #933). Both spellings of the separator count — spaced and glued. The glued form matters
# most: both readings parse cleanly, so reading it as an operator would change the dictionary
# silently instead of raising a diagnostic. Each entry is read back so the reading is proven, not
# assumed — a dict's printed form does not show its entries.
define two
  return 2
end

:spaced = { a: 1
mod: 2
and : 3
or:4
is :two }
print :spaced.a
print :spaced.mod
print :spaced.and
print :spaced.or
print :spaced.is

:glued = { a: 1
mod:two }
print :glued.mod

# The separator may even sit on its own line: parseDictEntry skips newlines between a key and
# its `:`, so this is an entry too, not `1 mod :two`.
:split = { a: 1
mod
:two }
print :split.mod

# With no separator after it, the same word IS an operator continuing the value above: this dict
# has ONE entry whose value is `5 mod 3`. The guard is scoped to the dictionary that owns the
# newline, so inside a nested list the word is an operator again.
:continued = { a: 5
mod 3 }
print :continued.a

:nested = { a: [1
mod 2] }
print :nested.a
